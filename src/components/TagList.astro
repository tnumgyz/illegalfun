---
interface Props {
	tags: string[];
	label?: string;
}

const { tags, label = 'Tags' } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tags" aria-label={label}>
			{tags.map((tag) => (
				<li>{tag}</li>
			))}
		</ul>
	)
}

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tags li {
		padding: 0.2rem 0.6rem;
		border: 1px solid var(--hairline);
		border-radius: var(--radius-image);
		color: var(--text-muted);
		font-size: 12px;
		letter-spacing: var(--tracking-eyebrow);
		text-transform: uppercase;
	}
</style>
